# Clé API Mistral (copiez-la en entier après le =, sans espaces).
# Selon l'époque, elle commence par « sk- » ou « mstrl- » : les deux fonctionnent.
MISTRAL_API_KEY=

# JSON du compte de service Google (ou chemin vers le fichier .json de la clé)
GOOGLE_DRIVE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"...@....iam.gserviceaccount.com",...}

# Optionnel : ID d'un dossier Google Drive existant à utiliser comme racine.
# Si vide, le serveur crée un dossier « PMJE - Observations » à la racine du Drive du compte de service.
DRIVE_ROOT_FOLDER_ID=

# Authentification Google de l'enseignante (OAuth 2.0, voir README)
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Si vide : http://localhost:3000/auth/callback (à enregistrer comme URI de redirection autorisé)
GOOGLE_OAUTH_REDIRECT_URI=

# Liste blanche des comptes Google autorisés à se connecter (emails séparés par des virgules).
# Si vide : tout compte Google peut se connecter.
ALLOWED_EMAILS=enseignante@exemple.ca
